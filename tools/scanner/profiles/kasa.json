{
  "name": "kasa",
  "endpoint": "/v1/execute_tool",
  "tool_field": "tool",
  "args_field": "arguments",
  "agent_field": "agent_id",
  "read_tool": "profile_read",
  "write_tool": "profile_write",
  "read_args": { "scope": "user.*", "reason": "scan" },
  "write_key": "system.security.rule",
