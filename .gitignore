build_nuitka*/

# Buyuk binary egitim/veri yedegi — kaynak degil (kod izlenir, veri izlenmez).
_bak_archive/*.db

# Kosum stdout/stderr dokumleri — gecici hata ayiklama ciktilari, kaynak degil.
err_l.txt
out_l.txt

# _orch orkestrasyon RUNTIME ciktilari — uretilen log/veri/durum/ara-urun, KAYNAK DEGIL.
# Kod olan .py araclar (redteam, training, loop) izlenmeye DEVAM eder; yalniz bu araclarin
# urettigi log/veri/taslak haric tutulur (diff kirliligi + calisma-ani gurultusu).
_orch/**/logs/
_orch/redteam/*.jsonl
_orch/**/state.json
_orch/loop/board.json
_orch/qwen_review/
_orch/**/*_draft.txt
_orch/**/*_review.txt

